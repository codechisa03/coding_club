rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Students / Users collection: Users can read/update their own profile
    match /students/{studentId} {
      allow read, update: if isOwner(studentId);
      allow create: if true;
    }

    // Quizzes: Public can read published quizzes
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if false; // Only Express Admin SDK can create/modify quizzes
      
      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Quiz Attempts: Students can read their own attempts
    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated() && resource.data.student_id == request.auth.uid;
      allow write: if false; // Submitted and graded strictly server-side
    }

    // Answers: Only writeable via Express Admin SDK
    match /answers/{answerId} {
      allow read, write: if false;
    }

    // Landing Media: Public read-only
    match /landing_media/{mediaId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny all other client access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
