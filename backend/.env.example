# Server
PORT=5000
NODE_ENV=development

# Must match the frontend's dev/prod URL(s). Comma-separate multiple origins.
CORS_ORIGIN=http://localhost:5173

# ── Supabase (Database) ───────────────────────────────────────────────────────
SUPABASE_URL=https://vvnfxujdcombyeukbqto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_URL=https://vvnfxujdcombyeukbqto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_JhdbHRQ73spHKaEXrSrtFw_dPGcUVZ1
SUPABASE_SECRET_KEY=sb_secret_AWHOyyypQ-9CtuAfN45ECQ_-nWy9ATs
SUPABASE_JWKS_URL=https://vvnfxujdcombyeukbqto.supabase.co/auth/v1/.well-known/jwks.json

# ── Landing Media (Firebase Storage) ─────────────────────────────────────────
LANDING_MEDIA_BUCKET_PREFIX=landing-media
LANDING_MEDIA_IMAGE_MAX_MB=8
LANDING_MEDIA_VIDEO_MAX_MB=60

# ── Code execution (judge) ────────────────────────────────────────────────────
CODE_EXEC_ENABLED=true
CODE_EXEC_PROVIDER=auto
CODE_EXEC_URL=
CODE_EXEC_TOKEN=
CODE_EXEC_TIMEOUT=15000
CODE_EXEC_FALLBACK=wandbox
WANDBOX_URL=https://wandbox.org/api/compile.json
WANDBOX_COMPILERS=

# ── Redis (For Load Balancing, Rate Limiting, & Caching) ─────────────────────
REDIS_URL=redis://localhost:6379

CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

GENERAL_RATE_LIMIT=300
AUTH_RATE_LIMIT=20
RATE_LIMIT_WINDOW_MS=60000

VITE_SUPABASE_URL=https://vvnfxujdcombyeukbqto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JhdbHRQ73spHKaEXrSrtFw_dPGcUVZ1