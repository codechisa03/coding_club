rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Landing page media & public assets: Read-only for everyone
    match /landing/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Uploads handled via Admin SDK in Express backend
    }

    // Student profile uploads: Authenticated users can read
    match /profiles/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Uploads verified and handled server-side
    }

    // Default deny for all other client writes
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
